rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // No client access at all.
    //
    // Storage rules cannot read Firestore, so they cannot consult the operator
    // allowlist — "signed in" was the strongest check available here, and
    // anyone can sign themselves up against the public config. So the browser
    // is denied outright instead.
    //
    // Every upload, download and delete now goes through /api/storage, which
    // verifies the operator session and returns a signed URL scoped to one
    // object for a few minutes. The Admin SDK is not subject to these rules,
    // and signed URLs are honoured without consulting them, so locking this
    // down breaks nothing the app does.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
