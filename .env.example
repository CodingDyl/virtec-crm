# Server-side Firebase credential, used only by the client portal
# (app/portal/[token] and app/api/portal/*).
#
# Firestore rules deny all browser access outside the operator allowlist, so
# portal pages — which have no signed-in user — are served by the Admin SDK
# instead. Without this value the portal returns "temporarily unavailable";
# the CRM itself is unaffected.
#
# Where to get it:
#   Firebase console -> Project settings -> Service accounts
#   -> Generate new private key  (downloads a JSON file)
#
# Then base64-encode the whole file and paste the single line below.
# Raw JSON also works, but base64 survives copy/paste and Vercel's editor:
#
#   macOS:  base64 -i serviceAccountKey.json | pbcopy
#
# On Vercel: Project -> Settings -> Environment Variables -> add
# FIREBASE_SERVICE_ACCOUNT for Production, Preview and Development.
#
# NEVER commit the real value. Copy this file to .env.local (gitignored).
FIREBASE_SERVICE_ACCOUNT=
