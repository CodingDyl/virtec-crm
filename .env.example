FIREBASE_SERVICE_ACCOUNT=
RESEND_API_KEY=
GOOGLE_PLACES_API_KEY=
# The most Google Places requests to pay for in a calendar month, across every
# scan. Places is billed per request, and the scan asks for phone and website,
# which is the dearer tier. Scans started from AgentOS are OFF until this is
# set. The operator's own scan works as before without it (usage is still
# counted). Check the current price, then pick a number you are happy to pay:
# a full Virtara scan is about 17 requests.
PLACES_MONTHLY_REQUEST_CAP=
AGENTOS_API_KEY=
# Separate key for AgentOS's two PATCH routes. Must differ from AGENTOS_API_KEY,
# or the write routes stay closed (503).
AGENTOS_WRITE_API_KEY=
# Website lead capture (POST /api/inbound/leads). One key per site, 24+ chars,
# each different from the other and from both AgentOS keys. The key a site
# sends decides the lead's track.
VIRTARA_SITE_LEADS_KEY=
JURIVO_SITE_LEADS_KEY=
# Optional: email the team when a website lead arrives (uses RESEND_API_KEY).
# Comma-separated for more than one address.
INBOUND_NOTIFY_EMAIL=
FROM_EMAIL=
# Lead magnet emails (the link to the guide, sent at signup). Per-site sender
# on a domain verified in Resend, e.g. "Virtara <hello@virtara.co.za>".
# Falls back to FROM_EMAIL. Reply-to falls back to INBOUND_NOTIFY_EMAIL.
VIRTARA_FROM_EMAIL=
VIRTARA_REPLY_TO=
JURIVO_FROM_EMAIL=
JURIVO_REPLY_TO=
